---
import CartView from "../../views/CartView.astro";
import { forwardJson, relayCookie, CART_BASE } from "../../lib/relay";
import { site, type Locale } from "../../config/site";
import type { Cart } from "../../lib/cart-types";

export async function getStaticPaths() {
  return site.locales
    .filter((l) => l !== site.defaultLocale)
    .map((locale) => ({ params: { locale } }));
}
const locale = (Astro.params.locale ?? "zh") as Locale;

const cookie = relayCookie(Astro.request);
const cartRes = await forwardJson(`${CART_BASE}/cart`, { method: "GET" }, cookie);
const cartJson = (await cartRes.json()) as { cart?: Cart };
const cart = cartJson.cart ?? null;

let rates: { id?: string; label?: string; name?: string; amount?: number }[] = [];
if (cart && cart.shippingAddress) {
  const rateRes = await forwardJson(`${CART_BASE}/cart/shipping-methods`, { method: "POST", body: "{}" }, cookie);
  const rateJson = (await rateRes.json()) as { options?: typeof rates };
  rates = rateJson.options ?? [];
}

const error = Astro.url.searchParams.get("error") !== null;
if (cartRes.headers.get("set-cookie")) {
  Astro.response.headers.append("set-cookie", cartRes.headers.get("set-cookie") as string);
}
---
<CartView {locale} {cart} {error} {rates} />
