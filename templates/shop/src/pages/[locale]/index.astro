---
import HomeView from "../../views/HomeView.astro";
import { catalogProducts, listTerms, getSettings } from "../../lib/emdash";
import { site, type Locale } from "../../config/site";
import { isLocale } from "../../config/site";
import { notFoundResponse } from "../../lib/not-found";

export async function getStaticPaths() {
  return site.locales
    .filter((l) => l !== site.defaultLocale)
    .map((locale) => ({ params: { locale } }));
}
const locale = Astro.params.locale as Locale;
if (!isLocale(locale)) return notFoundResponse();
const products = await catalogProducts(locale);
const categories = await listTerms("product_category");
const currency = (await getSettings()).defaultCurrency ?? "USD";
---
<HomeView {locale} {products} {categories} {currency} />
