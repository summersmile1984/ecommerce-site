---
import OrdersLookupView from "../../../views/OrdersLookupView.astro";
import { forwardJson, lookupPath } from "../../../lib/relay";
import { summarizeOrders, type OrderSummary } from "../../../lib/orders";
import { site, type Locale } from "../../../config/site";
import { isLocale } from "../../../config/site";
import { notFoundResponse } from "../../../lib/not-found";

export async function getStaticPaths() {
  return site.locales
    .filter((l) => l !== site.defaultLocale)
    .map((locale) => ({ params: { locale } }));
}
const locale = (Astro.params.locale ?? "zh") as Locale;
if (!isLocale(locale)) return notFoundResponse();


let email = "";
let orders: OrderSummary[] | undefined;
let error: string | undefined;

if (Astro.request.method === "POST") {
  const form = new URLSearchParams(await Astro.request.text());
  email = (form.get("email") ?? "").trim();
  if (!email.includes("@")) {
    error = "valid email required";
  } else {
    const res = await forwardJson(lookupPath(email), { method: "GET" });
    if (res.ok) {
      const json = (await res.json()) as { items?: unknown };
      orders = summarizeOrders(json);
    } else {
      error = `lookup failed (${res.status})`;
    }
  }
}
---
<OrdersLookupView {locale} {email} {orders} {error} />
