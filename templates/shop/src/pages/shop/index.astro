---
import ShopView from "../../views/ShopView.astro";
import { catalogProducts, listTerms, getSettings } from "../../lib/emdash";
import { parseFacets, applyFacets, shopNoindex } from "../../lib/facets";
import { localizePath } from "../../i18n/routing";
import { site } from "../../config/site";

const facets = parseFacets(Astro.url.searchParams);
const products = await catalogProducts("en");
const currency = (await getSettings()).defaultCurrency ?? "USD";
const { items, total, pageCount } = applyFacets(products, facets, site.pageSize, currency);
const categories = await listTerms("product_category");
---
<ShopView
  locale="en"
  {items}
  {total}
  {pageCount}
  {facets}
  {categories}
  {currency}
  canonical={localizePath("/shop", "en")}
  noindex={shopNoindex(facets)}
  basePath="/shop"
/>
