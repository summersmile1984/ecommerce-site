---
import CheckoutView from "../views/CheckoutView.astro";
import { forwardJson, relayCookie, CART_BASE } from "../lib/relay";
import type { Cart } from "../lib/cart-types";

// The checkout FORM posts to /api/checkout/session (the relay) — this page
// only renders the summary; create-session runs there so browsers get 303s.
const cookie = relayCookie(Astro.request);
const cartRes = await forwardJson(`${CART_BASE}/cart`, { method: "GET" }, cookie);
const cartJson = (await cartRes.json()) as { cart?: Cart };
const cart = cartJson.cart;
if (!cart || cart.items.length === 0) {
  return new Response(null, { status: 303, headers: { Location: "/cart" } });
}
if (cartRes.headers.get("set-cookie")) {
  Astro.response.headers.append("set-cookie", cartRes.headers.get("set-cookie") as string);
}
const modeRes = await forwardJson(`${CART_BASE}/checkout/mode`, { method: "GET" }, cookie);
const modeJson = (await modeRes.json()) as { mode?: string };
const errParam = Astro.url.searchParams.get("error");
const error = errParam === "notconfigured" ? "notconfigured" : errParam ? "generic" : undefined;
---
<CheckoutView locale="en" {cart} mode={modeJson.mode ?? "hosted"} {error} />
