---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import CategoryNav from "../components/CategoryNav.astro";
import { t } from "../i18n/ui";
import { localizePath } from "../i18n/routing";
import type { Locale } from "../config/site";
import type { Product, TaxTerm } from "../lib/emdash";

interface Props {
  locale: Locale;
  products: Product[];
  categories: TaxTerm[];
  currency: string;
}
const { locale, products, categories, currency } = Astro.props;
const featured = products.filter((p) => p.data.featured).slice(0, 4);
const shelf = featured.length > 0 ? featured : products.slice(0, 4);
---
<BaseLayout
  title={t("site.name", locale)}
  description={t("home.hero", locale)}
  {locale}
  path={localizePath("/", locale)}
>
  <div class="wrap">
    <section class="hero">
      <h1>{t("home.hero", locale)}</h1>
      <p class="tag">{t("home.categories", locale)}</p>
      <CategoryNav {locale} terms={categories} />
    </section>
    <section>
      <h2 class="section">{t("home.featured", locale)}</h2>
      <div class="grid">
        {shelf.map((p) => <ProductCard product={p} {locale} {currency} />)}
      </div>
      <p class="more">
        <a href={localizePath("/shop", locale)}>{t("shop.title", locale)} →</a>
      </p>
    </section>
  </div>
</BaseLayout>
<style>
  .wrap {
    max-width: 64rem;
    margin: 0 auto;
    padding: var(--space-5) var(--space-3);
  }
  .hero h1 {
    font-size: clamp(2.6rem, 8vw, 5.5rem);
    margin: 0;
    letter-spacing: -0.02em;
    max-width: 14ch;
  }
  .tag {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin: var(--space-4) 0 var(--space-3);
  }
  .section {
    font-size: 1.4rem;
    margin: var(--space-6) 0 var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--hairline);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--space-4);
  }
  .more {
    margin-top: var(--space-4);
  }
  .more a {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 4px;
  }
</style>
