---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import CategoryNav from "../components/CategoryNav.astro";
import { t } from "../i18n/ui";
import { localizePath } from "../i18n/routing";
import { canonicalUrl, jsonLdOrganization, jsonLdWebSite } from "../lib/seo";
import type { Locale } from "../config/site";
import type { Product, TaxTerm } from "../lib/emdash";

interface Props {
  locale: Locale;
  products: Product[];
  categories: TaxTerm[];
  currency: string;
}
const { locale, products, categories, currency } = Astro.props;
const featured = products.filter((p) => p.data.featured).slice(0, 4);
const shelf = featured.length > 0 ? featured : products.slice(0, 4);
---
<BaseLayout
  title={t("site.name", locale)}
  description={t("home.hero", locale)}
  {locale}
  path={localizePath("/", locale)}
  jsonLd={[
    jsonLdOrganization(t("site.name", locale), canonicalUrl(Astro.site!.toString(), localizePath("/", locale))),
    jsonLdWebSite(t("site.name", locale), canonicalUrl(Astro.site!.toString(), localizePath("/", locale))),
  ]}
>
  <div class="wrap">
    <section class="hero">
      <h1 class="display-1">{t("home.hero", locale)}</h1>
      <p class="eyebrow">{t("home.categories", locale)}</p>
      <CategoryNav {locale} terms={categories} />
    </section>
    <section>
      <h2 class="section">{t("home.featured", locale)}</h2>
      <div class="grid">
        {shelf.map((p) => <ProductCard product={p} {locale} {currency} />)}
      </div>
      <p class="more">
        <a href={localizePath("/shop", locale)}>{t("shop.title", locale)} →</a>
      </p>
    </section>
  </div>
</BaseLayout>
<style>
  .wrap {
    max-width: 64rem;
    margin: 0 auto;
    padding: var(--space-5) var(--space-3);
  }
  .hero {
    padding: var(--gap-section) 0 var(--gap-block);
    display: grid;
    gap: var(--space-4);
  }
  .hero .display-1 {
    max-width: 12ch;
  }
  .section {
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    font-family: var(--font-body);
    font-weight: 500;
    margin: 0 0 var(--gap-block);
    padding-bottom: var(--space-2);
    border-bottom: var(--rule);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--gap-block);
  }
  .grid > :first-child {
    grid-column: span 2;
  }
  @media (max-width: 52rem) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 30rem) {
    .grid {
      grid-template-columns: 1fr;
    }
    .grid > :first-child {
      grid-column: span 1;
    }
  }
  .more {
    margin-top: var(--space-4);
  }
  .more a {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 4px;
  }
</style>
