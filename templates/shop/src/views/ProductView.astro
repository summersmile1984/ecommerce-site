---
import BaseLayout from "../layouts/BaseLayout.astro";
import AddToCartForm from "../components/AddToCartForm.astro";
import ReviewForm from "../components/ReviewForm.astro";
import { getSettings } from "../lib/emdash";
import { forwardJson, CART_BASE } from "../lib/relay";
import { canonicalUrl, jsonLdProduct, jsonLdBreadcrumb } from "../lib/seo";
import { t, productTypeLabel } from "../i18n/ui";
import { localizePath } from "../i18n/routing";
import { posterFor, imageUrl } from "../lib/poster";
import type { Locale } from "../config/site";
import type { Product } from "../lib/emdash";

interface Props {
  product: Product;
  locale: Locale;
  translations?: Record<string, string>;
}
const { product, locale, translations } = Astro.props;
const currency = (await getSettings()).defaultCurrency ?? "USD";
const path = localizePath(`/shop/${product.slug}`, locale);
const url = canonicalUrl(Astro.site!.toString(), path);
// Real image when the backend has one, else the same poster field as the cards.
const kind = product.data.type ?? "simple";
const poster = posterFor(kind, productTypeLabel(kind, locale));
const imageSrc = imageUrl(product.data.featured_image);
const imageAlt =
  (product.data.featured_image as { alt?: string } | null | undefined)?.alt ?? product.data.title;

// description: plain string or portable-text array
const rawDesc = product.data.description;
const description = Array.isArray(rawDesc)
  ? rawDesc
      .map((b: { children?: { text?: string }[] }) => (b?.children ?? []).map((c) => c?.text ?? "").join(" "))
      .join("\n")
  : String(rawDesc ?? "");

// reviews list — server-side, public route (non-critical: failures render empty)
interface ReviewDto {
  id: string;
  rating: number;
  body: string;
  customerName?: string;
  createdAt?: string;
}
interface ReviewsResponse {
  reviews?: ReviewDto[];
  summary?: { count?: number; average?: number } | null;
  cursor?: string | null;
  hasMore?: boolean;
}
let reviews: ReviewDto[] = [];
let summary: { count?: number; average?: number } | null = null;
let nextCursor: string | null = null;
try {
  const pageCursor = Astro.url.searchParams.get("reviewCursor");
  const qs = new URLSearchParams({ productId: product.id, limit: "5" });
  if (pageCursor) qs.set("cursor", pageCursor);
  const res = await forwardJson(`${CART_BASE}/reviews/list?${qs}`, {
    method: "GET",
  });
  const json = (await res.json()) as ReviewsResponse;
  reviews = json.reviews ?? [];
  summary = json.summary ?? null;
  nextCursor = json.hasMore && json.cursor ? json.cursor : null;
} catch {
  /* reviews are non-critical */
}

const pairs = [
  { locale, hreflang: locale, href: url },
  ...Object.entries(translations ?? {}).map(([l, slug]) => ({
    locale: l,
    hreflang: l,
    href: canonicalUrl(Astro.site!.toString(), localizePath(`/shop/${slug}`, l as Locale)),
  })),
];
const crumbs = [
  { name: t("shop.title", locale), url: canonicalUrl(Astro.site!.toString(), localizePath("/shop", locale)) },
  { name: product.data.title, url },
];
---
<BaseLayout
  title={product.data.title}
  description={description.slice(0, 160) || t("shop.title", locale)}
  {locale}
  {path}
  alternates={pairs}
  ogType="product"
  {translations}
  jsonLd={[
    jsonLdProduct({ product, url, currency }),
    jsonLdBreadcrumb(crumbs),
  ]}
>
  <div class="wrap">
    <nav class="crumb">
      <a href={localizePath("/shop", locale)}>← {t("shop.title", locale)}</a>
    </nav>
    <div class="cols">
      {
        imageSrc ? (
          <div class="art" aria-hidden="true">
            <img
              class="art-img"
              src={imageSrc}
              alt={imageAlt}
              loading="lazy"
              decoding="async"
            />
          </div>
        ) : (
          <div
            class="art poster"
            data-texture={poster.texture}
            aria-hidden="true"
            style={`--poster-bg:${poster.bg};--poster-ink:${poster.ink}`}
          >
            <span class="poster-label">{poster.label}</span>
          </div>
        )
      }
      <div class="info">
        <p class="eyebrow">{poster.label}</p>
        <h1>{product.data.title}</h1>
        <AddToCartForm {product} {locale} {currency} returnTo={path} />
        {description && (
          <section class="desc">
            <p>{description}</p>
          </section>
        )}
        <section id="reviews" class="reviews">
          <h2>{t("pdp.reviews", locale)}</h2>
          {Astro.url.searchParams.get("review") === "ok" && (
            <p class="flash">{t("pdp.reviewThanks", locale)}</p>
          )}
          {Astro.url.searchParams.get("review") === "error" && (
            <p class="flash err">{t("error.retry", locale)}</p>
          )}
          {summary && typeof summary.average === "number" && (
            <p class="summary tabular">★ {summary.average.toFixed(1)} · {summary.count ?? reviews.length}</p>
          )}
          {reviews.length === 0 && <p class="muted">{t("pdp.noReviews", locale)}</p>}
          <ul>
            {reviews.map((r) => (
              <li>
                <strong>{"★".repeat(Math.max(1, Math.min(5, r.rating)))}</strong>{" "}
                {r.customerName && <span class="muted">{r.customerName}</span>}
                <p>{r.body}</p>
              </li>
            ))}
          </ul>
          {nextCursor && (
            <p class="pager">
              <a href={`?reviewCursor=${encodeURIComponent(nextCursor)}#reviews`}>→ {t("pager.next", locale)}</a>
            </p>
          )}
          <ReviewForm productId={product.id} {locale} returnTo={path} />
        </section>
      </div>
    </div>
  </div>
</BaseLayout>
<style>
  .wrap {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-5) var(--space-3);
  }
  .crumb a {
    text-decoration: none;
    color: var(--muted);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .cols {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: var(--gap-block);
    margin-top: var(--space-4);
  }
  @media (max-width: 52rem) {
    .cols {
      grid-template-columns: 1fr;
    }
  }
  .art {
    aspect-ratio: 4 / 5;
    border: 0;
    overflow: hidden;
    background: var(--poster-bg, #efe9e0);
    container-type: inline-size;
  }
  .art-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .art.poster {
    display: grid;
    place-items: center;
    color: var(--poster-ink, #241f1a);
    container-type: inline-size;
  }
  .art.poster[data-texture="grid"] {
    background-image: repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.05) 0 1px, transparent 1px 28px),
      repeating-linear-gradient(90deg, rgba(0, 0, 0, 0.05) 0 1px, transparent 1px 28px);
  }
  .art.poster[data-texture="grain"] {
    background-image: radial-gradient(rgba(0, 0, 0, 0.08) 1px, transparent 1px);
    background-size: 6px 6px;
  }
  .art.poster .poster-label {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--display-3);
    font-size: clamp(1rem, 9cqi, var(--display-3));
    letter-spacing: -0.03em;
    text-transform: uppercase;
    text-align: center;
    padding: 0 var(--space-3);
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--display-2);
    line-height: 0.98;
    letter-spacing: -0.04em;
    margin: 0;
  }
  .desc p {
    color: var(--muted);
    max-width: var(--measure);
    white-space: pre-line;
  }
  .reviews {
    margin-top: var(--space-5);
    border-top: 1px solid var(--hairline);
    padding-top: var(--space-4);
  }
  .reviews ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  .reviews li {
    border-bottom: 1px solid var(--hairline);
    padding-bottom: var(--space-2);
  }
  .summary {
    color: var(--muted);
  }
  .muted {
    color: var(--muted);
  }
  .flash {
    border-left: 3px solid #3f9d63;
    padding: 0.4rem 0.8rem;
    background: rgb(63 157 99 / 0.08);
  }
  .flash.err {
    border-left-color: var(--accent);
    background: rgb(200 68 42 / 0.08);
  }
</style>
