---
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatMoney } from "../lib/emdash";
import type { Cart, ShippingRate } from "../lib/cart-types";
import { localizePath } from "../i18n/routing";
import { t } from "../i18n/ui";
import type { Locale } from "../config/site";

interface Props {
  locale: Locale;
  cart: Cart | null;
  error?: boolean;
  rates: ShippingRate[];
}
const { locale, cart, error, rates } = Astro.props;
const hasAddress = !!cart?.shippingAddress;
---
<BaseLayout title={t("cart.title", locale)} description={t("cart.title", locale)} {locale} path={localizePath("/cart", locale)}>
  <div class="wrap">
    <h1>{t("cart.title", locale)}</h1>
    {error && <p class="banner" role="alert">{t("error.retry", locale)}</p>}
    {!cart || cart.items.length === 0 ? (
      <p class="empty">
        {t("cart.empty", locale)} <a href="/shop">{t("nav.shop", locale)} →</a>
      </p>
    ) : (
      <div class="grid">
        <table>
          <thead>
            <tr>
              <th>{t("nav.shop", locale)}</th>
              <th>{t("cart.quantity", locale)}</th>
              <th class="num">{t("cart.subtotal", locale)}</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {cart.items.map((item) => (
              <tr>
                <td>{item.title}</td>
                <td>
                  <form method="post" action="/api/cart/item" class="inline">
                    <input type="hidden" name="lineId" value={item.lineId} />
                    <input type="hidden" name="_method" value="PATCH" />
                    <input type="hidden" name="returnTo" value="/cart" />
                    <input class="tabular" type="number" name="quantity" value={item.quantity} min="0" max="999" aria-label={t("cart.quantity", locale)} />
                    <button type="submit" aria-label="✓">↻</button>
                  </form>
                </td>
                <td class="num tabular">{formatMoney(item.lineSubtotal.amount, item.lineSubtotal.currency)}</td>
                <td>
                  <form method="post" action="/api/cart/item" class="inline">
                    <input type="hidden" name="lineId" value={item.lineId} />
                    <input type="hidden" name="_method" value="DELETE" />
                    <input type="hidden" name="returnTo" value="/cart" />
                    <button type="submit" class="link">{t("cart.remove", locale)}</button>
                  </form>
                </td>
              </tr>
            ))}
          </tbody>
          <tfoot>
            <tr>
              <td colspan="3" class="num">{t("cart.subtotal", locale)}</td>
              <td class="num tabular">{formatMoney(cart.subtotal.amount, cart.subtotal.currency)}</td>
            </tr>
            {cart.discountTotal.amount > 0 && (
              <tr>
                <td colspan="3" class="num">−</td>
                <td class="num tabular">−{formatMoney(cart.discountTotal.amount, cart.discountTotal.currency)}</td>
              </tr>
            )}
            {cart.shippingTotal.amount > 0 && (
              <tr>
                <td colspan="3" class="num">Shipping</td>
                <td class="num tabular">{formatMoney(cart.shippingTotal.amount, cart.shippingTotal.currency)}</td>
              </tr>
            )}
            {cart.taxTotal.amount > 0 && (
              <tr>
                <td colspan="3" class="num">Tax</td>
                <td class="num tabular">{formatMoney(cart.taxTotal.amount, cart.taxTotal.currency)}</td>
              </tr>
            )}
            <tr class="grand">
              <td colspan="3" class="num"><strong>Total</strong></td>
              <td class="num tabular"><strong>{formatMoney(cart.total.amount, cart.total.currency)}</strong></td>
            </tr>
          </tfoot>
        </table>

        <aside class="side">
          <form method="post" action="/api/cart/coupon" class="panel">
            <label>
              {t("cart.coupon", locale)}
              <input name="code" placeholder="SAVE10" required />
            </label>
            <input type="hidden" name="returnTo" value="/cart" />
            <button type="submit">{t("cart.apply", locale)}</button>
          </form>
          {cart.coupons.length > 0 && (
            <form method="post" action="/api/cart/coupon/remove" class="panel">
              <p class="tabular">{cart.coupons.map((c) => c.code).join(", ")}</p>
              <input type="hidden" name="returnTo" value="/cart" />
              <button type="submit" class="ghost">{t("cart.remove", locale)}</button>
            </form>
          )}

          <form method="post" action="/api/cart/shipping-location" class="panel">
            <p class="label">Shipping</p>
            <label>
              Country
              <input name="country" value={cart.shippingAddress?.country ?? ""} placeholder="US" required />
            </label>
            <label>
              Postal code
              <input name="postalCode" value={cart.shippingAddress?.postalCode ?? ""} placeholder="10001" required />
            </label>
            <input type="hidden" name="returnTo" value="/cart" />
            <button type="submit" class="ghost">Save address</button>
          </form>

          {hasAddress && rates.length > 0 && (
            <form method="post" action="/api/cart/shipping-method" class="panel">
              <p class="label">Method</p>
              {rates.map((r) => (
                <label class="rate">
                  <input
                    type="radio"
                    name="methodId"
                    value={r.id ?? ""}
                    checked={cart.shippingMethod?.id === r.id}
                  />
                  {r.label ?? r.name} · {formatMoney(r.amount ?? r.price?.amount ?? 0, cart.currency)}
                </label>
              ))}
              <input type="hidden" name="returnTo" value="/cart" />
              <button type="submit" class="ghost">Use method</button>
            </form>
          )}

          <a class="checkout" href="/checkout">{t("cart.checkout", locale)} →</a>
        </aside>
      </div>
    )}
  </div>
</BaseLayout>
<style>
  .wrap {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-5) var(--space-3);
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
  }
  .banner {
    border-left: 3px solid var(--accent);
    padding: 0.5rem 1rem;
    background: rgb(200 68 42 / 0.08);
  }
  .empty {
    color: var(--muted);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: var(--space-5);
  }
  @media (max-width: 52rem) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  table {
    width: 100%;
    border-collapse: collapse;
  }
  th,
  td {
    padding: 0.6rem 0.4rem;
    border-bottom: 1px solid var(--hairline);
    text-align: left;
    font-size: 0.95rem;
  }
  .num {
    text-align: right;
  }
  tfoot .grand td {
    border-top: 2px solid var(--ink);
    font-size: 1.05rem;
  }
  .inline {
    display: inline-flex;
    gap: 0.3rem;
    align-items: center;
  }
  .inline input[type="number"] {
    width: 3.5rem;
    padding: 0.25rem;
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
  }
  .inline button,
  .link {
    background: none;
    border: none;
    color: var(--muted);
    text-decoration: underline;
    cursor: pointer;
    font-size: 0.85rem;
    padding: 0;
  }
  .inline button:hover,
  .link:hover {
    color: var(--accent);
  }
  .side {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }
  .panel {
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: var(--space-3);
    display: grid;
    gap: var(--space-2);
  }
  .panel label {
    display: grid;
    gap: 0.2rem;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .panel input {
    font: inherit;
    padding: 0.4rem 0.5rem;
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
  }
  .panel input:focus {
    border-color: var(--accent);
    outline: none;
  }
  .label {
    margin: 0;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .rate {
    display: flex;
    gap: 0.4rem;
    align-items: center;
    font-size: 0.9rem;
    text-transform: none;
    letter-spacing: normal;
    color: var(--ink);
  }
  button {
    background: var(--accent);
    color: var(--paper);
    border: 0;
    border-radius: var(--radius);
    padding: 0.45rem 0.9rem;
    font-weight: 600;
    cursor: pointer;
  }
  button.ghost {
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--hairline);
  }
  .checkout {
    display: block;
    text-align: center;
    background: var(--accent);
    color: var(--paper);
    text-decoration: none;
    border-radius: var(--radius);
    padding: 0.6rem 1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
</style>
