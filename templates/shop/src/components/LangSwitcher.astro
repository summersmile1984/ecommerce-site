---
import { t } from "../i18n/ui";
import { localizePath, stripLocale, replaceLastSegment } from "../i18n/routing";
import { site, type Locale } from "../config/site";

interface Props {
  locale: Locale;
  path: string;
  translations?: Record<string, string>;
}
const { locale, path, translations } = Astro.props;
const other: Locale = locale === site.defaultLocale ? "zh" : "en";
// Post pages pass translation slugs (same content, other language);
// other pages switch to the same path under the other locale prefix.
const target = translations?.[other]
  ? replaceLastSegment(stripLocale(path), translations[other])
  : localizePath(stripLocale(path), other);
---
<a class="lang" href={target} hreflang={other}>{t("lang.switch", locale)}</a>
<style>
  .lang {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: none;
    color: var(--muted);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: 0.15rem 0.5rem;
  }
  .lang:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>
