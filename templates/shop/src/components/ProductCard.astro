---
import { priceOf, type Product } from "../lib/emdash";
import { localizePath } from "../i18n/routing";
import { productTypeLabel } from "../i18n/ui";
import { posterFor, imageUrl } from "../lib/poster";
import type { Locale } from "../config/site";
import Price from "./Price.astro";

interface Props {
  product: Product;
  locale: Locale;
  currency: string;
}
const { product, locale, currency } = Astro.props;
const href = localizePath(`/shop/${product.slug}`, locale);
const price = priceOf(product, currency);
const out = product.data.stock_status === "outofstock";
const zh = product.locale !== locale; // untranslated product served via fallback
const kind = product.data.type ?? "simple";
// Real image when the backend has one; otherwise a generated poster field.
const imageSrc = imageUrl(product.data.featured_image);
const imageAlt =
  (product.data.featured_image as { alt?: string } | null | undefined)?.alt ?? product.data.title;
const poster = posterFor(kind, productTypeLabel(kind, locale));
---
<article class="card">
  {
    imageSrc ? (
      <a class="art" href={href} aria-hidden="true" tabindex="-1">
        <img
          class="art-img"
          src={imageSrc}
          alt={imageAlt}
          loading="lazy"
          decoding="async"
        />
      </a>
    ) : (
      <a
        class="art poster"
        href={href}
        data-texture={poster.texture}
        style={`--poster-bg:${poster.bg};--poster-ink:${poster.ink}`}
        aria-hidden="true"
        tabindex="-1"
      >
        <span class="poster-label">{poster.label}</span>
      </a>
    )
  }
  <div class="info">
    <h3><a href={href}>{product.data.title}</a></h3>
    <p class="meta">
      <Price minor={price?.amount ?? null} currency={price?.currency ?? currency} />
      <span class:list={["dot", out && "out"]}></span>
      <span class="kind">{poster.label}</span>
      {zh && <span class="fallback">EN</span>}
    </p>
  </div>
</article>
<style>
  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .art {
    display: block;
    aspect-ratio: 1 / 1;
    background: #efe9e0;
    border-bottom: var(--rule);
    overflow: hidden;
    text-decoration: none;
    container-type: inline-size;
  }
  .art-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .poster {
    display: grid;
    place-items: center;
    background: var(--poster-bg);
    color: var(--poster-ink);
  }
  .poster[data-texture="grid"] {
    background-image: repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.05) 0 1px, transparent 1px 28px),
      repeating-linear-gradient(90deg, rgba(0, 0, 0, 0.05) 0 1px, transparent 1px 28px);
  }
  .poster[data-texture="grain"] {
    background-image: radial-gradient(rgba(0, 0, 0, 0.08) 1px, transparent 1px);
    background-size: 6px 6px;
  }
  .poster-label {
    font-family: var(--font-display);
    font-weight: 900;
    /* scale the label to the tile so long type names never clip */
    font-size: clamp(0.9rem, 9cqi, var(--display-3));
    letter-spacing: -0.03em;
    text-transform: uppercase;
    padding: 0 var(--space-3);
    text-align: center;
    text-decoration: none;
    max-width: 100%;
    overflow-wrap: anywhere;
  }
  .info {
    padding: var(--space-3) 0 0;
    display: grid;
    gap: var(--space-1);
  }
  h3 {
    margin: 0;
    font-size: 1.1rem;
    letter-spacing: -0.02em;
  }
  h3 a {
    text-decoration: none;
  }
  h3 a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .meta {
    margin: 0;
    display: flex;
    gap: var(--space-2);
    align-items: center;
    font-size: 0.78rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #3f9d63;
    flex: none;
  }
  .dot.out {
    background: var(--muted);
  }
  .kind {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .fallback {
    border: 1px solid var(--hairline);
    padding: 0 0.35rem;
  }
</style>
