---
import { slugifyHeading } from "../lib/toc";

interface Props {
  body: unknown;
}
const { body } = Astro.props;
const blocks = Array.isArray(body)
  ? (body as { style?: string; children?: { text?: string }[] }[])
  : [];
---
<div class="prose">
  {
    blocks.map((b) => {
      const text = (b.children ?? []).map((c) => c.text ?? "").join("");
      if (b.style === "h2") return <h2 id={slugifyHeading(text)} set:html={text} />;
      if (b.style === "h3") return <h3 id={slugifyHeading(text)} set:html={text} />;
      return <p set:html={text} />;
    })
  }
</div>
<style is:global>
  .prose {
    max-width: var(--measure);
  }
  .prose h2 {
    margin-top: var(--space-5);
    font-size: 1.6rem;
    scroll-margin-top: 5rem;
  }
  .prose h3 {
    margin-top: var(--space-4);
    font-size: 1.2rem;
    scroll-margin-top: 5rem;
  }
  .prose p {
    margin: 0 0 var(--space-3);
  }
</style>
