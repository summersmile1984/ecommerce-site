---
import { t } from "../i18n/ui";
import { localizePath, stripLocale } from "../i18n/routing";
import type { Locale } from "../config/site";
import ThemeToggle from "./ThemeToggle.astro";
import LangSwitcher from "./LangSwitcher.astro";

interface Props {
  locale: Locale;
  path: string;
  translations?: Record<string, string>;
}
const { locale, path, translations } = Astro.props;
const bare = stripLocale(path);
const nav = [
  { href: localizePath("/", locale), label: t("nav.home", locale), match: bare === "/" },
  { href: localizePath("/blog", locale), label: t("nav.blog", locale), match: bare === "/blog" || bare.startsWith("/blog/") },
  { href: localizePath("/about", locale), label: t("nav.about", locale), match: bare === "/about" },
  { href: localizePath("/search", locale), label: t("nav.search", locale), match: bare === "/search" },
];
---
<header class="site-header">
  <a class="wordmark" href={localizePath("/", locale)}>{t("site.name", locale)}</a>
  <nav aria-label="Main">
    {nav.map((n) => <a href={n.href} aria-current={n.match ? "page" : undefined}>{n.label}</a>)}
  </nav>
  <div class="header-tools">
    <LangSwitcher locale={locale} path={path} {translations} />
    <ThemeToggle locale={locale} />
  </div>
</header>
<style>
  .site-header {
    display: flex;
    gap: var(--space-5);
    align-items: baseline;
    padding: var(--space-4) var(--space-3);
    max-width: 64rem;
    margin: 0 auto;
    border-bottom: var(--rule);
    flex-wrap: wrap;
  }
  .wordmark {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  nav {
    display: flex;
    gap: var(--space-3);
    margin-left: auto;
    flex-wrap: wrap;
  }
  nav a {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    text-decoration: none;
    color: var(--muted);
  }
  nav a[aria-current="page"],
  nav a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }
  .header-tools {
    display: flex;
    gap: var(--space-2);
    align-items: center;
  }
</style>
