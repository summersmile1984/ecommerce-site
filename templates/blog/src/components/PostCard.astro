---
import type { Post } from "../lib/emdash";
import { localizePath } from "../i18n/routing";
import type { Locale } from "../config/site";

interface Props {
  post: Post;
  locale: Locale;
  index?: number;
}
const { post, locale, index } = Astro.props;
const href = localizePath(`/blog/${post.slug}`, locale);
const date = post.publishedAt.slice(0, 10);
const zh = post.locale !== locale; // 回退标记
---
<article class="row">
  {index !== undefined && <span class="idx" aria-hidden="true">{String(index).padStart(2, "0")}</span>}
  <div class="row-body">
    <h2><a href={href}>{post.data.title}</a></h2>
    <p class="excerpt">{post.data.excerpt}</p>
    <p class="meta">
      <time datetime={post.publishedAt}>{date}</time>
      {zh && <span class="fallback">EN</span>}
    </p>
  </div>
</article>
<style>
  .row {
    display: flex;
    gap: var(--space-5);
    padding: var(--space-5) 0;
    border-bottom: var(--rule);
    min-width: 0;
  }
  .row-body {
    min-width: 0;
  }
  .idx {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--muted);
    font-size: 2.2rem;
    line-height: 1;
    padding-top: 0.15rem;
  }
  @media (max-width: 52rem) {
    .row {
      flex-direction: column;
      gap: var(--space-2);
    }
    /* after the base rule, otherwise the later base wins */
    .idx {
      font-size: 1.4rem;
    }
  }
  .row h2 {
    margin: 0 0 var(--space-1);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.6rem;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .row h2 a {
    text-decoration: none;
  }
  .row h2 a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .excerpt {
    margin: 0 0 var(--space-2);
    color: var(--muted);
    max-width: var(--measure);
  }
  .meta {
    margin: 0;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
    display: flex;
    gap: var(--space-2);
  }
  .fallback {
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: 0 0.35rem;
  }
</style>
