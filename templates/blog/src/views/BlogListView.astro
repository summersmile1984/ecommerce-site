---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import Pagination from "../components/Pagination.astro";
import { t } from "../i18n/ui";
import { localizePath } from "../i18n/routing";
import type { Locale } from "../config/site";
import type { Post } from "../lib/emdash";

interface Props {
  locale: Locale;
  posts: Post[];
  page: number;
  pageCount: number;
  basePath: string;
  title?: string;
}
const { locale, posts, page, pageCount, basePath, title = t("nav.blog", locale) } = Astro.props;
const path = localizePath(basePath, locale) + (page > 1 ? `/page/${page}` : "");
---
<BaseLayout
  title={page > 1 ? `${title} · ${t("blog.page", locale)} ${page}` : title}
  description={t("home.latest", locale)}
  {locale}
  {path}
>
  <div class="wrap">
    <h1 class="page-title">{title}</h1>
    {posts.length === 0 && <p class="empty">{t("search.empty", locale)}</p>}
    <div class="grid">
      {posts.map((p, i) => <PostCard post={p} {locale} index={page === 1 ? i + 1 : undefined} />)}
    </div>
    <Pagination {page} {pageCount} {basePath} {locale} />
  </div>
</BaseLayout>
<style>
  .wrap {
    max-width: 64rem;
    margin: 0 auto;
    padding: var(--space-5) var(--space-3);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gap-block);
  }
  /* :global() — the cards are child components, so this scope cannot
     reach them (Astro scopes styles to the component that renders them) */
  .grid > :global(:first-child) {
    grid-column: span 8;
  }
  .grid > :global(:not(:first-child)) {
    grid-column: span 4;
  }
  .grid > :global(:first-child) :global(h2) {
    font-size: var(--display-2);
    line-height: 1.1;
  }
  @media (max-width: 52rem) {
    /* 12 tracks + 3rem gaps cannot fit a phone — drop to one column */
    .grid {
      grid-template-columns: 1fr;
    }
    .grid > :global(:first-child),
    .grid > :global(:not(:first-child)) {
      grid-column: auto;
    }
  }
  .page-title {
    font-size: clamp(2.2rem, 6vw, 3.5rem);
    margin: 0 0 var(--space-4);
  }
  .empty {
    color: var(--muted);
  }
</style>
