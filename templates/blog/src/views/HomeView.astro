---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { t } from "../i18n/ui";
import { localizePath } from "../i18n/routing";
import type { Locale } from "../config/site";
import type { Post, TaxTerm } from "../lib/emdash";

interface Props {
  locale: Locale;
  posts: Post[];
  categories: TaxTerm[];
}
const { locale, posts, categories } = Astro.props;
---
<BaseLayout title={t("site.name", locale)} description={t("home.latest", locale)} {locale} path={localizePath("/", locale)}>
  <div class="wrap">
    <section class="hero">
      <h1>{t("site.name", locale)}</h1>
      <p class="eyebrow">{t("home.latest", locale)}</p>
    </section>
    <div class="grid">
      {posts.map((p, i) => <PostCard post={p} {locale} index={i + 1} />)}
    </div>
    <section class="cats">
      <h2>{t("home.categories", locale)}</h2>
      <ul>
        {categories.map((c) => (
          <li><a href={localizePath(`/blog/category/${c.slug}`, locale)}>{c.label}</a></li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
<style>
  .wrap {
    max-width: 64rem;
    margin: 0 auto;
    padding: var(--space-5) var(--space-3);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gap-block);
  }
  /* :global() — the cards are child components, so this scope cannot
     reach them (Astro scopes styles to the component that renders them) */
  .grid > :global(:first-child) {
    grid-column: span 8;
  }
  .grid > :global(:not(:first-child)) {
    grid-column: span 4;
  }
  .grid > :global(:first-child) :global(h2) {
    font-size: var(--display-2);
    line-height: 1.1;
  }
  @media (max-width: 52rem) {
    /* 12 tracks + 3rem gaps cannot fit a phone — drop to one column */
    .grid {
      grid-template-columns: 1fr;
    }
    .grid > :global(:first-child),
    .grid > :global(:not(:first-child)) {
      grid-column: auto;
    }
  }
  .hero h1 {
    font-size: clamp(3rem, 10vw, 6rem);
    margin: 0;
    letter-spacing: -0.02em;
  }
  .tag {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin: var(--space-2) 0 var(--space-5);
  }
  .cats {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--hairline);
  }
  .cats ul {
    list-style: none;
    padding: 0;
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .cats a {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 4px;
  }
</style>
