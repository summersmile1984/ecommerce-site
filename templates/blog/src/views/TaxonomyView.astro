---
import BlogListView from "./BlogListView.astro";
import { t } from "../i18n/ui";
import type { Locale } from "../config/site";
import type { Post, TaxTerm } from "../lib/emdash";

interface Props {
  locale: Locale;
  term: TaxTerm;
  posts: Post[];
  kind: "category" | "tag";
}
const { locale, term, posts, kind } = Astro.props;
const basePath = `/blog/${kind}/${term.slug}`;
const kindLabel = t(kind === "category" ? "tax.category" : "tax.tag", locale);
---
<BlogListView
  {locale}
  {posts}
  page={1}
  pageCount={1}
  {basePath}
  title={`${kindLabel} · ${term.label}`}
/>
